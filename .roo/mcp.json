{
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ],
      "env": {
        "DEFAULT_MINIMUM_TOKENS": ""
      }
    },
    "CRUD_API": {
      "type": "sse",
      "name": "CRUD API",
      "url": "http://localhost:4000/sse",
      "disabled": false,
      "alwaysAllow": []
    }
  }
}