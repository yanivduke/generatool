{
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ],
      "env": {
        "DEFAULT_MINIMUM_TOKENS": ""
      }
    },
    "CRUD_API": {
      "type": "sse",
      "name": "CRUD API",
      "url": "http://localhost:4000/sse",
      "disabled": false,
      "alwaysAllow": [
        "search_model_data"
      ]
    },
    "Figma_MCP_Server": {
      "type": "sse",
      "name": "Figma MCP Server",
      "url": "http://localhost:3333/sse",
      "disabled": false
    }
  }
}